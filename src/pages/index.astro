---
import Base from '../layouts/Base.astro';
---

<Base
  title="nstate"
  description="Dismantle overreaching, wasteful states — through transparency and solutions. Open-source government accountability, starting with the UK."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero__label badge badge--amber">open source · UK chapter active</div>
      <h1 class="hero__headline">
        Dismantle overreaching,<br />wasteful states.
      </h1>
      <p class="hero__sub">
        Through transparency and solutions. nstate audits every public pound against its stated
        objective, proves what fails, and builds the open-source tools to do it cheaper.
      </p>
      <div class="hero__cta">
        <a href="/uk" class="btn btn--primary">see the UK audit →</a>
        <a href="/contribute" class="btn btn--ghost">contribute</a>
      </div>
    </div>
  </section>

  <!-- Ticker-style stat bar -->
  <div class="ticker">
    <div class="container ticker__inner">
      <span class="ticker__item">
        <span class="ticker__label">UK public spending 2024–25</span>
        <span class="ticker__val">£1.26tn</span>
      </span>
      <span class="ticker__sep">|</span>
      <span class="ticker__item">
        <span class="ticker__label">scorecards published</span>
        <span class="ticker__val ticker__val--amber">0</span>
      </span>
      <span class="ticker__sep">|</span>
      <span class="ticker__item">
        <span class="ticker__label">countries</span>
        <span class="ticker__val">1</span>
      </span>
      <span class="ticker__sep">|</span>
      <span class="ticker__item">
        <span class="ticker__label">open data pipelines</span>
        <span class="ticker__val ticker__val--amber">in progress</span>
      </span>
    </div>
  </div>

  <!-- How it works -->
  <section class="how">
    <div class="container">
      <div class="section-label">how it works</div>
      <div class="how__grid">
        <div class="how__step">
          <div class="how__num">01</div>
          <h3>audit</h3>
          <p>
            Every scorecard starts with publicly available data. We cite the source, state the
            method, and publish the code. If you can't reproduce it, we haven't done the job.
          </p>
        </div>
        <div class="how__step">
          <div class="how__num">02</div>
          <h3>benchmark</h3>
          <p>
            We don't just say "this is bad." We build counterfactuals — what the same money
            could achieve under a different policy, compared against comparable countries
            and historical evidence.
          </p>
        </div>
        <div class="how__step">
          <div class="how__num">03</div>
          <h3>publish</h3>
          <p>
            Every finding is public, versioned, and correctable. Got better data? Open a PR.
            Disagree with the analysis? Submit a counter-scorecard. The methodology is the contract.
          </p>
        </div>
        <div class="how__step">
          <div class="how__num">04</div>
          <h3>automate</h3>
          <p>
            Phase 3: open-source agents that shadow administrative processes — not to replace
            human judgement, but to show which tasks deterministic software could do cheaper,
            faster and without political capture.
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Scorecards preview -->
  <section class="scorecards">
    <div class="container">
      <div class="section-label">UK scorecards</div>
      <h2>first wave in progress</h2>
      <p class="section-sub">
        We are building the data pipelines before publishing any numbers.
        Priority areas based on fiscal scale, data availability, and benchmarkability.
      </p>
      <div class="cards">
        <a href="/uk#scorecards" class="card card--upcoming">
          <div class="card__meta">
            <span class="badge badge--grey">pipeline: in progress</span>
          </div>
          <h3 class="card__title">Energy levies on bills</h3>
          <p class="card__desc">
            Policy costs embedded in household bills vs. general taxation: fiscal impact,
            distributional incidence, international comparison.
          </p>
          <div class="card__footer">
            <span class="card__country">UK</span>
            <span class="card__dept">DESNZ · Ofgem · OBR</span>
          </div>
        </a>

        <a href="/uk#scorecards" class="card card--upcoming">
          <div class="card__meta">
            <span class="badge badge--grey">pipeline: in progress</span>
          </div>
          <h3 class="card__title">VAT on independent schools</h3>
          <p class="card__desc">
            Projected revenue vs. fiscal displacement through state sector admissions,
            cross-border migration, and teaching staff costs.
          </p>
          <div class="card__footer">
            <span class="card__country">UK</span>
            <span class="card__dept">HMRC · DfE · OBR</span>
          </div>
        </a>

        <a href="/uk#scorecards" class="card card--upcoming">
          <div class="card__meta">
            <span class="badge badge--grey">pipeline: queued</span>
          </div>
          <h3 class="card__title">Civil service headcount growth</h3>
          <p class="card__desc">
            Headcount and real-terms pay vs. service delivery metrics,
            2000–present. Productivity per civil servant vs. OECD peers.
          </p>
          <div class="card__footer">
            <span class="card__country">UK</span>
            <span class="card__dept">Cabinet Office · ONS · OECD</span>
          </div>
        </a>
      </div>
      <p class="cards__note">
        No numbers are published until the data pipeline is live and peer-reviewed.
        That is the point.
      </p>
    </div>
  </section>

  <hr class="divider" />

  <!-- Mission statement -->
  <section class="mission">
    <div class="container">
      <div class="section-label">mission</div>
      <blockquote class="mission__quote">
        nstate shows you exactly how governments waste your money — and builds the
        open-source tools to fix it. The end goal: a minimum viable state that
        costs less, does more, and leaves you alone.
      </blockquote>
      <div class="mission__phases">
        <div class="mission__phase">
          <span class="mission__phase-num">phase 1</span>
          <strong>show the waste</strong>
          <span>reproducible policy scorecards, published data, open pipelines</span>
        </div>
        <div class="mission__phase">
          <span class="mission__phase-num">phase 2</span>
          <strong>build the fix</strong>
          <span>open-source tools any government could adopt; shadow agents that demonstrate cheaper alternatives</span>
        </div>
        <div class="mission__phase">
          <span class="mission__phase-num">phase 3</span>
          <strong>scale the movement</strong>
          <span>country chapters fork the methodology; international coalition; governments competing on transparency</span>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Countries -->
  <section class="countries">
    <div class="container">
      <div class="section-label">countries</div>
      <h2>start your chapter</h2>
      <p class="section-sub">
        The methodology is country-agnostic. Fork the template, adapt your data sources,
        open a PR. Every country deserves an audit.
      </p>
      <div class="country-list">
        <a href="/uk" class="country-item country-item--active">
          <span class="country-item__name">United Kingdom</span>
          <span class="badge badge--amber">active</span>
        </a>
        <div class="country-item country-item--open">
          <span class="country-item__name">Your country →</span>
          <a href="/contribute#country-chapter" class="badge badge--grey">open a chapter</a>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>join the audit</h2>
      <p>
        Data analysts, economists, developers, journalists — if you can write a Python
        pipeline or check a source, you can contribute.
      </p>
      <div class="cta-section__btns">
        <a href="/contribute" class="btn btn--primary">how to contribute →</a>
        <a href="https://github.com/nstate-project/nstate" class="btn btn--ghost" target="_blank" rel="noopener">
          star on github ↗
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--border);
  }

  .hero__label {
    margin-bottom: 1.5rem;
  }

  .hero__headline {
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    max-width: 18ch;
  }

  .hero__sub {
    font-size: 1.05rem;
    color: var(--text-2);
    margin-bottom: 2.5rem;
    max-width: 55ch;
  }

  .hero__cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    font-family: var(--font);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.7rem 1.4rem;
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .btn--primary {
    background: var(--amber);
    color: var(--bg);
    border-color: var(--amber);
  }

  .btn--primary:hover {
    background: #e6b800;
    color: var(--bg);
    border-color: #e6b800;
  }

  .btn--ghost {
    background: transparent;
    color: var(--text-2);
    border-color: var(--border-2);
  }

  .btn--ghost:hover {
    color: var(--text);
    border-color: var(--text-3);
  }

  /* Ticker */
  .ticker {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .ticker__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0.9rem 0;
    font-size: 0.75rem;
    align-items: center;
  }

  .ticker__item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .ticker__label {
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.65rem;
  }

  .ticker__val {
    font-weight: 700;
    color: var(--text);
  }

  .ticker__val--amber { color: var(--amber); }

  .ticker__sep {
    color: var(--border-2);
    align-self: center;
  }

  /* How it works */
  .how {
    padding: 4rem 0;
  }

  .how__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .how__step {
    border-top: 2px solid var(--border);
    padding-top: 1.5rem;
  }

  .how__num {
    font-size: 0.7rem;
    color: var(--amber);
    font-weight: 700;
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
  }

  .how__step h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .how__step p {
    font-size: 0.85rem;
    color: var(--text-2);
    max-width: none;
  }

  /* Section labels */
  .section-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 0.75rem;
  }

  .section-sub {
    color: var(--text-2);
    margin-top: 0.5rem;
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  /* Scorecards */
  .scorecards {
    padding: 4rem 0;
  }

  .scorecards h2 {
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }

  .card {
    background: var(--bg);
    padding: 1.5rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background 0.15s;
  }

  .card:hover {
    background: var(--surface);
  }

  .card__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
  }

  .card__desc {
    font-size: 0.82rem;
    color: var(--text-2);
    flex: 1;
    max-width: none;
  }

  .card__footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--text-3);
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
    margin-top: auto;
  }

  .cards__note {
    font-size: 0.78rem;
    color: var(--text-3);
    max-width: 55ch;
  }

  /* Mission */
  .mission {
    padding: 4rem 0;
  }

  .mission__quote {
    font-size: 1.2rem;
    font-style: normal;
    border-left: 3px solid var(--amber);
    padding-left: 1.5rem;
    margin: 1.5rem 0 2.5rem;
    color: var(--text-2);
    max-width: 60ch;
    line-height: 1.7;
  }

  .mission__phases {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .mission__phase {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .mission__phase-num {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--amber);
  }

  .mission__phase strong {
    font-size: 0.95rem;
  }

  .mission__phase span {
    font-size: 0.82rem;
    color: var(--text-2);
    max-width: none;
  }

  /* Countries */
  .countries {
    padding: 4rem 0;
  }

  .countries h2 {
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
  }

  .country-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    margin-top: 2rem;
  }

  .country-item {
    background: var(--bg);
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    transition: background 0.15s;
  }

  .country-item:hover {
    background: var(--surface);
  }

  .country-item__name {
    font-size: 0.9rem;
    color: var(--text);
  }

  .country-item--open .country-item__name {
    color: var(--text-3);
  }

  /* CTA section */
  .cta-section {
    padding: 4rem 0;
  }

  .cta-section h2 {
    font-size: 1.6rem;
    margin-bottom: 0.75rem;
  }

  .cta-section p {
    color: var(--text-2);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .cta-section__btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
