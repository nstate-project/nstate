---
import Base from '../layouts/Base.astro';

const examples = [
  "How many civil servants work for the UK government?",
  "What are the biggest categories of UK government spending?",
  "How much did HMRC collect in income tax last year?",
  "What is the average UK private sector salary?",
  "How many people claim Universal Credit?",
];
---

<Base
  title="Ask"
  description="Query UK government data in plain English. Every answer is backed by official data — no estimates, no spin."
>
  <div class="container">
    <div class="page-header">
      <div class="breadcrumb"><a href="/">nstate</a> / <span>ask</span></div>
      <h1>Ask the data</h1>
      <p class="sub">
        Query UK government data in plain English. Every answer is backed by official
        data — Cabinet Office, ONS, HMRC, HM Treasury. No estimates, no spin.
      </p>
    </div>
  </div>

  <div class="ask-bar">
    <div class="container">
      <form id="ask-form" class="ask-form">
        <input
          id="q"
          type="text"
          class="ask-input"
          placeholder="How much does the UK government spend on the NHS per year?"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
        />
        <button type="submit" class="ask-btn" id="ask-btn">ask →</button>
      </form>
    </div>
  </div>

  <div class="container">
    <div class="examples">
      <span class="examples__label">try:</span>
      {examples.map(ex => (
        <button class="example-pill" data-q={ex}>{ex}</button>
      ))}
    </div>

    <!-- Results -->
    <div id="results" class="results" hidden>
      <!-- Narrative -->
      <div class="result-block" id="block-narrative">
        <div class="result-block__label">answer</div>
        <p id="narrative" class="narrative"></p>
        <div class="key-stat" id="key-stat" hidden>
          <span id="key-stat-value" class="key-stat__value"></span>
          <span id="key-stat-unit" class="key-stat__unit"></span>
        </div>
      </div>

      <!-- Chart -->
      <div class="result-block" id="block-chart" hidden>
        <div class="result-block__label">chart</div>
        <div id="chart-container"></div>
      </div>

      <!-- Table -->
      <div class="result-block" id="block-table" hidden>
        <div class="result-block__label">data</div>
        <div class="table-scroll">
          <table id="data-table" class="data-table"></table>
        </div>
      </div>

      <!-- SQL -->
      <details class="result-block sql-details" id="block-sql" hidden>
        <summary class="result-block__label">SQL query</summary>
        <pre id="sql-pre" class="sql-pre"></pre>
      </details>

      <!-- Source -->
      <div class="source-line" id="source-line"></div>
    </div>

    <!-- Gap state -->
    <div id="gap" class="gap-block" hidden>
      <div class="gap-block__icon">○</div>
      <p id="gap-reason" class="gap-block__reason"></p>
      <p class="gap-block__sub">
        nstate only answers from official data. If the data isn't in our pipeline yet,
        the answer is: we don't have it.
      </p>
    </div>

    <!-- Error state -->
    <div id="error" class="error-block" hidden>
      <p id="error-msg"></p>
    </div>

    <!-- Loading -->
    <div id="loading" class="loading" hidden>
      <span class="loading__dots">querying</span>
    </div>
  </div>
</Base>

<script>
const API = 'https://api.nstate.org/query';

function show(id) { document.getElementById(id).hidden = false; }
function hide(id) { document.getElementById(id).hidden = true; }
function hideAll() {
  ['results','gap','error','loading'].forEach(hide);
  ['block-chart','block-table','block-sql','key-stat'].forEach(hide);
}

function renderTable(rows, cols) {
  const tbl = document.getElementById('data-table');
  const head = cols.map(c => `<th>${c.replace(/_/g,' ')}</th>`).join('');
  const body = rows.map(r =>
    `<tr>${cols.map(c => `<td>${r[c] ?? ''}</td>`).join('')}</tr>`
  ).join('');
  tbl.innerHTML = `<thead><tr>${head}</tr></thead><tbody>${body}</tbody>`;
  show('block-table');
}

function renderChart(spec) {
  const el = document.getElementById('chart-container');
  if (!spec || !window.vegaEmbed) return;
  const themed = {
    ...spec,
    background: '#0a0a0a',
    config: {
      view: { stroke: '#1f1f1f' },
      axis: { gridColor: '#1f1f1f', domainColor: '#2a2a2a', labelColor: '#9ca3af', titleColor: '#9ca3af' },
      mark: { color: '#facc15' },
    },
  };
  window.vegaEmbed(el, themed, { actions: false, renderer: 'svg' })
    .then(() => { show('block-chart'); })
    .catch(() => {});
}

async function query(question) {
  hideAll();
  document.getElementById('q').value = question;
  show('loading');

  try {
    const res = await fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ question }),
    });
    if (!res.ok) throw new Error(`API error ${res.status}`);
    const data = await res.json();
    hide('loading');

    if (data.status === 'gap') {
      document.getElementById('gap-reason').textContent = data.reason || 'Data not available.';
      show('gap');
      return;
    }

    document.getElementById('narrative').textContent = data.narrative || '';
    show('results');

    if (data.key_stat_value != null) {
      const fmt = new Intl.NumberFormat('en-GB', { maximumFractionDigits: 1 });
      document.getElementById('key-stat-value').textContent = fmt.format(data.key_stat_value);
      document.getElementById('key-stat-unit').textContent = data.key_stat_unit || '';
      show('key-stat');
    }

    if (data.chart_spec) renderChart(data.chart_spec);
    if (data.rows?.length) renderTable(data.rows, data.columns || []);

    if (data.sql) {
      document.getElementById('sql-pre').textContent = data.sql;
      show('block-sql');
    }

    if (data.source) {
      document.getElementById('source-line').textContent = `source: ${data.source}`;
    }

  } catch (err) {
    hide('loading');
    document.getElementById('error-msg').textContent =
      `Could not reach the API. Check your connection and try again. (${err.message})`;
    show('error');
  }
}

document.getElementById('ask-form').addEventListener('submit', e => {
  e.preventDefault();
  const q = document.getElementById('q').value.trim();
  if (q) query(q);
});

document.querySelectorAll('.example-pill').forEach(btn => {
  btn.addEventListener('click', () => query(btn.dataset.q));
});
</script>

<!-- Vega-Embed for charts -->
<script src="https://cdn.jsdelivr.net/npm/vega@5/build/vega.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-lite@5/build/vega-lite.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-embed@6/build/vega-embed.min.js"></script>

<style>
  .page-header {
    padding: 3rem 0 2rem;
  }

  .breadcrumb {
    font-size: 0.75rem;
    color: var(--text-3);
    margin-bottom: 1rem;
  }

  .breadcrumb a { color: var(--amber); text-decoration: none; }

  .page-header h1 {
    font-size: 2.2rem;
    margin-bottom: 0.75rem;
  }

  .sub {
    color: var(--text-2);
    font-size: 0.9rem;
    max-width: 60ch;
  }

  /* Ask bar */
  .ask-bar {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    padding: 1.5rem 0;
    position: sticky;
    top: 3.5rem;
    z-index: 90;
  }

  .ask-form {
    display: flex;
    gap: 0.75rem;
  }

  .ask-input {
    flex: 1;
    background: var(--bg);
    border: 1px solid var(--border-2);
    color: var(--text);
    font-family: var(--font);
    font-size: 0.9rem;
    padding: 0.75rem 1rem;
    outline: none;
    min-width: 0;
    transition: border-color 0.15s;
  }

  .ask-input:focus {
    border-color: var(--amber);
  }

  .ask-input::placeholder {
    color: var(--text-3);
  }

  .ask-btn {
    background: var(--amber);
    color: var(--bg);
    border: 1px solid var(--amber);
    font-family: var(--font);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.75rem 1.4rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s;
  }

  .ask-btn:hover {
    background: #e6b800;
  }

  /* Examples */
  .examples {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .examples__label {
    font-size: 0.7rem;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .example-pill {
    background: transparent;
    border: 1px solid var(--border-2);
    color: var(--text-2);
    font-family: var(--font);
    font-size: 0.75rem;
    padding: 0.3rem 0.75rem;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.15s, color 0.15s;
  }

  .example-pill:hover {
    border-color: var(--amber);
    color: var(--text);
  }

  /* Loading */
  .loading {
    padding: 3rem 0;
    color: var(--text-3);
    font-size: 0.85rem;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .loading__dots {
    animation: blink 1s ease-in-out infinite;
  }

  /* Result blocks */
  .results {
    padding: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    margin: 2rem 0;
  }

  .result-block {
    background: var(--bg);
    padding: 1.5rem;
  }

  .result-block__label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--amber);
    margin-bottom: 0.75rem;
    cursor: default;
  }

  .narrative {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 70ch;
  }

  .key-stat {
    margin-top: 1.25rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .key-stat__value {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--amber);
    letter-spacing: -0.03em;
  }

  .key-stat__unit {
    font-size: 0.85rem;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Table */
  .table-scroll {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .data-table th {
    text-align: left;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 1rem 0.5rem 0;
  }

  .data-table td {
    padding: 0.45rem 1rem 0.45rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-2);
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  /* SQL */
  .sql-details summary {
    cursor: pointer;
    list-style: none;
  }

  .sql-details summary::-webkit-details-marker {
    display: none;
  }

  .sql-pre {
    font-family: var(--font);
    font-size: 0.78rem;
    color: var(--text-2);
    background: var(--surface);
    padding: 1rem;
    overflow-x: auto;
    line-height: 1.5;
    margin-top: 0.75rem;
    border: 1px solid var(--border);
  }

  /* Source */
  .source-line {
    font-size: 0.7rem;
    color: var(--text-3);
    padding: 0.75rem 1.5rem;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  /* Gap */
  .gap-block {
    padding: 3rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .gap-block__icon {
    font-size: 1.5rem;
    color: var(--text-3);
  }

  .gap-block__reason {
    font-size: 0.95rem;
    color: var(--text-2);
    max-width: 55ch;
  }

  .gap-block__sub {
    font-size: 0.82rem;
    color: var(--text-3);
    max-width: 55ch;
  }

  /* Error */
  .error-block {
    padding: 2rem 0;
    color: #f87171;
    font-size: 0.85rem;
  }
</style>
