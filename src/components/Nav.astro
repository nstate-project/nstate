---
const links = [
  { href: '/ask', label: 'ask' },
  { href: '/uk', label: 'UK' },
  { href: '/countries', label: 'countries' },
  { href: '/methodology', label: 'methodology' },
  { href: '/contribute', label: 'contribute' },
];

const current = Astro.url.pathname;
---

<nav class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__logo">nstate</a>
    <ul class="nav__links">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav__link', { 'nav__link--active': current.startsWith(link.href) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href="https://github.com/nstate-project/nstate" class="nav__link nav__link--gh" target="_blank" rel="noopener">
          github ↗
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 100;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }

  .nav__logo {
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    color: var(--amber);
    letter-spacing: -0.02em;
  }

  .nav__logo:hover {
    color: var(--amber);
    opacity: 0.8;
  }

  .nav__links {
    display: flex;
    list-style: none;
    gap: 0.25rem;
    align-items: center;
  }

  .nav__link {
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--text-2);
    padding: 0.35rem 0.6rem;
    border: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  .nav__link:hover {
    color: var(--text);
  }

  .nav__link--active {
    color: var(--text);
    border-color: var(--border-2);
  }

  .nav__link--gh {
    color: var(--text-3);
  }
</style>
