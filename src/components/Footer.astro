<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__left">
      <span class="footer__logo">nstate</span>
      <span class="footer__tag">your government, audited.</span>
    </div>
    <div class="footer__links">
      <a href="https://github.com/nstate-project/nstate" target="_blank" rel="noopener">github</a>
      <a href="/methodology">methodology</a>
      <a href="/contribute">contribute</a>
      <a href="https://github.com/nstate-project/nstate/blob/main/LICENSE" target="_blank" rel="noopener">CC BY 4.0</a>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>data cited, sources linked, corrections published. no government affiliation.</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    margin-top: 6rem;
    padding: 2rem 0 3rem;
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .footer__left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .footer__logo {
    font-weight: 700;
    color: var(--amber);
    font-size: 0.9rem;
  }

  .footer__tag {
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .footer__links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer__links a {
    font-size: 0.8rem;
    color: var(--text-3);
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--text);
  }

  .footer__bottom {
    font-size: 0.7rem;
    color: var(--text-3);
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
</style>
